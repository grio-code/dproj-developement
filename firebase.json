{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "firebase-debug.log",
      "firebase-starter/firebase.rules",
      "firebase-starter/storage.rules"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "firebase-starter/storage.rules"
  },
  "firestore": {
    "rules": "firebase-starter/firebase.rules"
  }
}